# Browser-facing URL when the frontend is served through the native Nginx proxy.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Nginx listens here; FastAPI and Next.js remain private upstreams during local use.
NGINX_PORT=8080
API_UPSTREAM=http://127.0.0.1:8000
WEB_UPSTREAM=http://127.0.0.1:3000
