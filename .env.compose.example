# Copy to .env before running Docker Compose if you want non-default values.
POSTGRES_DB=circlespace
POSTGRES_USER=circlespace
POSTGRES_PASSWORD=circlespace-local
SECRET_KEY=local-compose-secret-change-before-production
APP_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
BACKEND_CORS_ORIGINS=http://localhost:8080
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
